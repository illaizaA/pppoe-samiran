MIKROTIK_SAMIRAN_PORT=8728
MIKROTIK_SAMIRAN_USERNAME=monitoring
MIKROTIK_SAMIRAN_PASSWORD=
MIKROTIK_SAMIRAN_NAME="ROUTER SAMIRAN-NGAGLIK"
MIKROTIK_SAMIRAN_TRANSPORT=api
MIKROTIK_SAMIRAN_SERVICE_CONFIRMED=true
MIKROTIK_SAMIRAN_SECURE_NETWORK=false
MIKROTIK_SAMIRAN_CA_FILE=
MIKROTIK_SAMIRAN_TLS_SERVER_NAME=

